# Copy to .env (git-ignored) and fill in. Only the ingestion CLI and the external-provider
# generation path read these; the Worker itself gets its bindings from wrangler.toml.

# --- Ingestion (scripts/ingest.ts) -------------------------------------------------
# API token with AI Search edit permission for the account.
CF_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Must match wrangler.toml's [[ai_search]] instance_name.
ASKABOT_AI_SEARCH_INSTANCE=askabot
# Optional; defaults to "default".
ASKABOT_AI_SEARCH_NAMESPACE=default
# User-Agent contact URL sent by the ingestion fetcher (identifies your crawler).
INGEST_UA_CONTACT=https://example.com

# --- External generation provider (generation.provider: external) ------------------
# Only needed when you route generation to a non-Workers-AI model through AI Gateway BYOK.
CF_ACCOUNT_ID=
CF_AIG_TOKEN=
